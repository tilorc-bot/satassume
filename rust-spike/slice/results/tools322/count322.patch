+fn nc_res(tag: &str, r: &PyResult<Bound<'_, PyAny>>) {
+    let v = match r {
+        Ok(v) if v.is_none() => "N",
+        Ok(v) if v.is_instance_of::<PyBool>() => {
+            if v.is_truthy().unwrap_or(false) {
+                "T"
+            } else {
+                "F"
+            }
+        }
+        Ok(_) => "O",
+        Err(_) => "X",
+    };
+    crate::solver::nc(&format!("{tag}{v}"));
+}
